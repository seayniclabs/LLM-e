{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seayniclabs.com/schemas/llme/provider-profile-1.0.json",
  "title": "LLM-e provider profile",
  "description": "The file LLM-e writes after setup and host apps (for example Sonique's provider adapters) read. Holds the AI connections a person has set up, which one handles everyday and harder questions, and the result of the last test. Never holds an API key: keys stay in the macOS Keychain and are referenced by key_ref.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_by", "created_at", "updated_at", "registry", "targets", "roles"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "Semantic version of this schema. Major 1 is this file. Hosts refuse a major they do not know and accept a minor they know or older."
    },
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version"],
      "properties": {
        "tool": {"type": "string", "minLength": 1, "maxLength": 64, "description": "Writer, e.g. llme or sonique."},
        "version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "date"],
      "description": "The signed model registry this profile's recommendations came from.",
      "properties": {
        "version": {"type": "string", "pattern": "^\\d{4}\\.\\d{1,2}\\.\\d+$"},
        "date": {"type": "string", "format": "date"}
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/target"}
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["everyday", "harder"],
      "description": "Which target handles everyday questions and which handles harder ones. Each value is a target id from targets. harder may be null when only one target is set up. Referential integrity (ids exist) is checked by llme.schemas.validate_profile, not by JSON Schema.",
      "properties": {
        "everyday": {"$ref": "#/$defs/targetId"},
        "harder": {"oneOf": [{"$ref": "#/$defs/targetId"}, {"type": "null"}]}
      }
    }
  },
  "$defs": {
    "targetId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "ollamaTag": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[a-z0-9][a-z0-9._-]*(/[a-z0-9._-]+)*:[A-Za-z0-9._-]+$",
      "description": "Exact tag as returned by Ollama GET /api/tags, e.g. llama3.2:3b. Never a guessed name (lessons 848, 923)."
    },
    "keyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "account"],
      "description": "Pointer to a macOS Keychain generic-password item. The key itself is never stored in this file.",
      "properties": {
        "service": {"type": "string", "minLength": 1, "maxLength": 200},
        "account": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "lastTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "tested_at"],
      "properties": {
        "status": {"enum": ["ok", "failed"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 300, "description": "Plain-language reason, shown to the person."},
        "tested_at": {"type": "string", "format": "date-time"}
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens_per_second", "time_to_first_token_ms", "measured_at"],
      "properties": {
        "tokens_per_second": {"type": ["number", "null"], "minimum": 0},
        "time_to_first_token_ms": {"type": ["number", "null"], "minimum": 0},
        "measured_at": {"type": "string", "format": "date-time"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "source", "endpoint", "model", "key_ref", "last_test", "performance"],
      "properties": {
        "id": {"$ref": "#/$defs/targetId"},
        "kind": {
          "enum": ["ollama_local", "ollama_remote", "apple_intelligence", "openai_compatible", "anthropic", "openrouter"]
        },
        "label": {"type": "string", "minLength": 1, "maxLength": 80},
        "source": {
          "enum": ["this_mac", "network_scan", "typed_address", "apple_system", "manual"],
          "description": "How the target was found. LLM-e and hosts contact only network_scan and typed_address devices, never other addresses."
        },
        "endpoint": {"type": ["string", "null"], "format": "uri", "maxLength": 300},
        "model": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
        "key_ref": {"oneOf": [{"$ref": "#/$defs/keyRef"}, {"type": "null"}]},
        "last_test": {"oneOf": [{"$ref": "#/$defs/lastTest"}, {"type": "null"}]},
        "performance": {"oneOf": [{"$ref": "#/$defs/performance"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "ollama_local"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "source": {"const": "this_mac"},
              "endpoint": {"type": "string", "pattern": "^http://(localhost|127\\.0\\.0\\.1):11434$"},
              "model": {"$ref": "#/$defs/ollamaTag"},
              "key_ref": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "ollama_remote"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "source": {"enum": ["network_scan", "typed_address"]},
              "endpoint": {"type": "string", "pattern": "^http://[A-Za-z0-9.-]+:11434$"},
              "model": {"$ref": "#/$defs/ollamaTag"},
              "key_ref": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "apple_intelligence"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "source": {"const": "apple_system"},
              "endpoint": {"type": "null"},
              "model": {"type": "null"},
              "key_ref": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"enum": ["openai_compatible", "anthropic", "openrouter"]}}, "required": ["kind"]},
          "then": {
            "properties": {
              "source": {"const": "manual"},
              "endpoint": {"type": "string", "format": "uri", "pattern": "^https://[^\\s/]+"},
              "model": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$", "maxLength": 200},
              "key_ref": {"$ref": "#/$defs/keyRef"}
            }
          }
        }
      ]
    }
  }
}
