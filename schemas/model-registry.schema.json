{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seayniclabs.com/schemas/llme/model-registry-1.0.json",
  "title": "LLM-e model registry",
  "description": "The shared list of local models that LLM-e and host apps (Sonique) recommend from. Shipped inside each release and signed with a detached signature (see registry-signature.schema.json). Carries each model's exact Ollama tag, requirements, licence and notice obligations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_version", "published_date", "models"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "registry_version": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{1,2}\\.\\d+$",
      "description": "Calendar-style: year.month.sequence, e.g. 2026.10.1."
    },
    "published_date": {"type": "string", "format": "date"},
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/model"}
    }
  },
  "$defs": {
    "ollamaTag": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[a-z0-9][a-z0-9._-]*(/[a-z0-9._-]+)*:[A-Za-z0-9._-]+$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tag", "family", "parameters", "size_on_disk_gb", "min_memory_gb", "acceleration", "licence", "recommended_for"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$", "description": "Stable slug. Unique within the registry."},
        "tag": {"$ref": "#/$defs/ollamaTag", "description": "Exact Ollama tag to pull. Unique within the registry."},
        "family": {"type": "string", "minLength": 1, "maxLength": 60},
        "parameters": {"type": "string", "pattern": "^[0-9.]+[BM]$", "description": "Parameter count, e.g. 3B."},
        "size_on_disk_gb": {"type": "number", "exclusiveMinimum": 0, "description": "Download and disk size shown to the person before any pull."},
        "min_memory_gb": {"type": "number", "exclusiveMinimum": 0, "description": "Smallest unified memory size the model is recommended for."},
        "acceleration": {
          "enum": ["none", "metal_recommended", "metal_required"],
          "description": "GPU needs on Apple silicon."
        },
        "licence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "url", "notice_required", "notice_text"],
          "properties": {
            "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]*$", "description": "SPDX identifier where one exists, otherwise a registry slug such as llama-3.2-community."},
            "name": {"type": "string", "minLength": 1, "maxLength": 120},
            "url": {"type": "string", "format": "uri"},
            "notice_required": {"type": "boolean"},
            "notice_text": {"type": ["string", "null"], "maxLength": 200, "description": "Text the UI must show, e.g. Built with Llama. Required when notice_required is true."}
          },
          "if": {"properties": {"notice_required": {"const": true}}, "required": ["notice_required"]},
          "then": {"properties": {"notice_text": {"type": "string", "minLength": 1}}}
        },
        "recommended_for": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "maxLength": 200},
          "description": "Plain-language notes shown with the recommendation."
        }
      }
    }
  }
}
